[Unit]
Description=Ensure Wi-Fi is actually connected before the network is online
After=NetworkManager.service
Before=network-online.target
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust path if you installed somewhere other than /home/pi
ExecStart=/home/pi/home-dashboard/scripts/pi/wifi-autoconnect.sh 90

[Install]
WantedBy=multi-user.target network-online.target
