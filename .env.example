# Astoria Home Dashboard config. Copy to .env and edit.
# All keys are optional; defaults match Phase 0 PLAN.md.

# --- Trains ---
# MTA_NQRW_FEED_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-nqrw
# STATION_STOP_ID=R06
# TRAIN_MAX_MINUTES=30
# TRAIN_FEED_CACHE_SECONDS=15

# --- Weather ---
# WEATHER_LAT=40.7568
# WEATHER_LON=-73.9296
# WEATHER_USER_AGENT=home-dashboard (local, you@example.com)
# WEATHER_CACHE_SECONDS=300

# --- Time / clock (seed defaults; user-tunable at runtime via the settings UI) ---
# TIMEZONE=America/New_York
# CLOCK_24H=0

# --- Photos ---
# Absolute path to a local directory containing jpg/png/webp/gif images.
# Leave commented to use the default (~/Pictures/dashboard).
# PHOTO_DIR=/absolute/path/to/your/pictures
# PHOTO_HEIC=0

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# Path to a built frontend (Phase 6). Leave unset during dev.
# STATIC_DIR=
